{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "开发管理助手",
  "version": "0.1.0",
  "identifier": "com.yingshu.devadminassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "开发管理助手", "width": 1320, "height": 820, "minWidth": 980, "minHeight": 720, "resizable": true, "fullscreen": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "统一管理开发资源的桌面应用",
    "longDescription": "开发管理助手 Tauri 桌面演示版。",
    "icon": []
  }
}
